<templates>
  <t t-name="owon.DisplayPopover">
    <div class="display-popover" t-ref="root">
      <button type="button" class="display-popover-toggle" aria-label="Display settings" title="Display settings"
              t-att-aria-expanded="state.open ? 'true' : 'false'" t-ref="toggle" t-on-click="toggle">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"/>
          <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"/>
        </svg>
      </button>
      <div t-if="state.open" class="display-popover-panel" role="dialog" aria-label="Display settings">
        <SliderField label="'Grid'" path="'display.gridBrightness'" min="gridRange.min" max="gridRange.max"
                     step="gridRange.step" text="gridText"/>
        <SliderField label="'Trace'" path="'display.traceWidth'" min="traceRange.min" max="traceRange.max"
                     step="traceRange.step" text="traceText"/>
        <button type="button" class="display-popover-reset" t-on-click="reset">Reset</button>
      </div>
    </div>
  </t>
</templates>
